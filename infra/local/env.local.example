# Local testing environment variables for Acme Corp tenant
# Do not commit real secrets here

# Database and Redis Connections (Docker Compose overwrites these, but provided as fallback)
DATABASE_URL=postgresql://postgres:password@localhost:5432/heytam
REDIS_URL=redis://localhost:6379

# Calling Agent Secrets
TWILIO_ACCOUNT_SID=AC_dummy_local_sid
TWILIO_AUTH_TOKEN=dummy_local_auth_token

# Mail Agent Secrets
ZOHO_CLIENT_ID=dummy_zoho_client_id
ZOHO_CLIENT_SECRET=dummy_zoho_client_secret

# Marketing Agent Secrets
META_APP_ID=dummy_meta_app_id
META_APP_SECRET=dummy_meta_app_secret
META_ACCESS_TOKEN=dummy_meta_access_token
