# Storage & Pub/Sub
DATABASE_URL=postgresql://postgres:password@localhost:5432/heytam
REDIS_URL=redis://localhost:6379

# AI Model Provider Selection
# Options: OPENAI, ANTHROPIC, COPILOT
AI_BACKEND=OPENAI

# AI Model API Keys (Global)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GITHUB_PAT=your_github_personal_access_token # For Copilot Subscription

# Application
NODE_ENV=development
