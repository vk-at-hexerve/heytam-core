# ─── AI Backend ──────────────────────────────────────────────────────────────
AI_BACKEND=OPENAI           # OPENAI | ANTHROPIC | COPILOT
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-... # Optional — for ANTHROPIC backend
GITHUB_PAT=ghp_...           # Optional — for COPILOT backend

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/heytam
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb+srv://...   # Optional — for MongoDB CRM tools
MONGODB_DB=heytam-ai-agents

# ─── Tenant Access ────────────────────────────────────────────────────────────
ALLOWED_TENANTS=tenant-acme,tenant-globex,tenant-demo  # Comma-separated allowed tenants

# ─── Twilio (Communication Tools) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_PHONE=+1...

# ─── SMTP (Email Tools) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=HeyTam AI <you@gmail.com>

# ─── Google APIs (Calendar + Sheets + Gmail) ──────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# ─── Inter-Agent Config ───────────────────────────────────────────────────────
INTER_AGENT_TIMEOUT_MS=10000
INTER_AGENT_RETRIES=3
INTER_AGENT_RETRY_DELAY_MS=250
